# Copy to .env.performance; launcher resolves auto against the Docker Linux daemon.
# auto: Haskell selects N permitted logical CPUs; web prefers a different core.
HASKELL_CPUSET=auto
WEB_CPUSET=auto
HASKELL_CAPABILITIES=1
# container: cpuset only; rts: also +RTS -qa, requires mask 0..N-1 and N=mask size.
HASKELL_AFFINITY=container
# Example RTS experiment (only if CPU 0 and 1 are permitted):
# HASKELL_CPUSET=0,1
# HASKELL_CAPABILITIES=2
# HASKELL_AFFINITY=rts
