# Docker Compose configuration (DK-01..DK-07); copy to .env before deployment.
# Do not export this file into the current native server/bridge unchanged.
# Compose interpolates .env; each service must receive only its explicit environment map.

# Haskell container: listen on its network; this TCP port is NOT published to the host.
BATTLESHIP_BIND_HOST=0.0.0.0
BATTLESHIP_TCP_PORT=4000
BATTLESHIP_READY_FILE=/tmp/battleship-ready

# Web container: resolve the Haskell service by Compose DNS.
BATTLESHIP_TCP_HOST=haskell
HOST=0.0.0.0
PORT=8080

# Publish HOST port 8081 -> container PORT 8080. Browser origins use WEB_PUBLIC_PORT.
WEB_PUBLIC_PORT=8081

# Default: localhost. For fixed LAN use the actual host IPv4 with the same public port.
# Change WEB_PUBLIC_PORT and PUBLIC_ORIGIN together in manual mode.
PUBLIC_ORIGIN=http://localhost:8081

# Optional dynamic LAN mode (DK-06): clear PUBLIC_ORIGIN and enable the file path.
# LAN_CONFIG_DIR is a HOST directory; mount it read-only at /run/battleship-lan in web.
# Mount the DIRECTORY, not one JSON file, so atomic replacements remain visible.
# Create this directory before Compose, including in manual/localhost mode.
LAN_CONFIG_DIR=./.docker-runtime/lan
LAN_ORIGINS_FILE=
# PUBLIC_ORIGIN=
# LAN_ORIGINS_FILE=/run/battleship-lan/origins.json

# Used only by the host LAN helper. Empty = all eligible host IPv4 interfaces.
# Set to the real host adapter name when Wi-Fi/VPN/Ethernet coexist.
LAN_INTERFACE=
