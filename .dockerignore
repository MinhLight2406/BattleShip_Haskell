frontend/dist
frontend/test-results
battleship-haskell.cabal
**/*.hi
**/*.o
**/*.dyn_hi
**/*.dyn_o
**/*.exe

# Keep docs/*.md and tests, exclude demo outputs and checkout bundles.
**/*.log
**/*.bundle
