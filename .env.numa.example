# Copy to .env.numa. IDs are resolved from Docker Linux topology, not Windows.
# default: default memory placement, controlled CPU/N; local/remote: same CPU/N.
# ghc: separate --numa experiment; never mix it into the local/remote comparison.
NUMA_PROFILE=local
NUMA_CPU_NODE=auto
NUMA_MEMORY_NODE=auto
HASKELL_CPUSET=auto
WEB_CPUSET=auto
HASKELL_CAPABILITIES=1
# cpuset restricts allowed RAM; membind additionally requests a strict policy.
NUMA_MEMORY_POLICY=cpuset
# Explicit experiment permission; default retains Docker's normal capabilities.
NUMA_SYS_NICE=0
# Minimum free RAM on selected memory node at preflight, not a reservation.
NUMA_MIN_FREE_MIB=64
